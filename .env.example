# Supabase (browser-safe publishable/anon key only — never put service_role in VITE_*)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose in frontend builds
SERVICE_ROLE_KEY=your-service-role-key

# OpenAI key must NOT go in VITE_*. Set it as a Supabase Edge Function secret named:
#   OPENAI_API_KEY
# Dashboard → Project Settings → Edge Functions → Secrets
# The frontend calls /functions/v1/openai-chat (no browser CORS to api.openai.com).

# Base path:
# - Render custom domain (storybuilder.pw): leave unset or "/"
# - GitHub Pages (path deploy): /storybuilder/
# VITE_BASE_PATH=/

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: https://storybuilder.pw/
# - Redirect URLs (add all that apply):
#   http://localhost:5173/**
#   http://localhost:5175/**
#   https://storybuilder.pw/**
#   https://storybuilder.pw/reset-password
#   https://www.storybuilder.pw/**
#   https://pab89154.github.io/storybuilder/**
#   https://pab89154.github.io/storybuilder/reset-password
