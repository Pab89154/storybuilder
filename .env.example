# Supabase (browser-safe publishable/anon key only — never put service_role in VITE_*)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose in frontend builds
SERVICE_ROLE_KEY=your-service-role-key

# Serve models from your own static host (recommended for production).
VITE_MODELS_BASE_URL=/models

# GitHub Pages base path (set in CI). Locally leave unset or use "/".
# This repository's production value: /storybuilder/
# VITE_BASE_PATH=/storybuilder/

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: https://pab89154.github.io/storybuilder/
# - Redirect URLs (add all that apply):
#   http://localhost:5173/**
#   http://localhost:5175/**
#   https://pab89154.github.io/storybuilder/**
#   https://pab89154.github.io/storybuilder/reset-password
